{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Master App (Frontend + Backend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:master"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "Master Backend (Express :8090)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/master", "run", "dev:backend"],
      "port": 8090
    },
    {
      "name": "Touch Kiosk (Frontend + Backend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:touch"],
      "port": 5174
    },
    {
      "name": "Touch Backend (Express :8091)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/touch", "run", "dev:backend"],
      "port": 8091
    },
    {
      "name": "Management Hub (Frontend :5175)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/management", "run", "dev"],
      "port": 5175
    },
    {
      "name": "Management Backend (Express :8787)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/management", "run", "dev:backend"],
      "port": 8787
    },
    {
      "name": "Gallery (Frontend :5176)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:gallery"],
      "port": 5176
    },
    {
      "name": "Gallery Backend (Express :8090)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/gallery", "run", "dev:backend"],
      "port": 8090
    },
    {
      "name": "Website (Next.js :3001)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:website"],
      "port": 3001
    },
    {
      "name": "MoneyTrash Uploader (Vite :5173)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/moneytrash", "run", "dev"],
      "port": 5173
    },
    {
      "name": "All Apps (concurrent)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    }
  ]
}
