{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/electron",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "declaration": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  },
  "include": ["electron-main.ts", "electron-security.ts", "preload.ts"],
  "exclude": ["src/**/*"]
}
