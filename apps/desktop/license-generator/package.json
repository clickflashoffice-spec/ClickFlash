{
  "name": "clickflash-license-generator",
  "version": "2.0.0",
  "description": "ClickFlash License Key Generator Desktop App",
  "author": "ClickFlash Photography",
  "private": true,
  "main": "dist/main.js",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json --watch",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit && node ../../../node_modules/esbuild/bin/esbuild src/main.ts src/preload.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --external:electron --minify --tsconfig=tsconfig.electron.json",
    "package": "pnpm run build && npx electron-builder",
    "package:win": "pnpm run build && npx electron-builder --win",
    "test": "vitest run --pool=forks",
    "lint": "echo \"No lint specified\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@clickflash/licensing": "workspace:*",
    "@clickflash/logger": "workspace:*",
    "@electron/asar": "3.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "39.8.7",
    "electron-builder": "26.15.7",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.1.13"
  }
}
