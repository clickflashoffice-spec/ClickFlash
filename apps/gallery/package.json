{
  "name": "star-master-customer",
  "version": "4.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npx wrangler dev",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "build": "vite build && node -e \"require('fs').copyFileSync('service-worker.js', 'dist/service-worker.js')\"",
    "preview": "vite preview",
    "deploy:backend": "cd backend && npx wrangler deploy",
    "start": "cd backend && npx wrangler dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit",
    "lint": "eslint src --max-warnings 500",
    "lint:fix": "eslint src --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "playwright:install": "playwright install"
  },
  "dependencies": {
    "@clickflash/types": "file:../../packages/types",
    "@clickflash/ui": "file:../../packages/ui",
    "@google/genai": "^1.51.0",
    "@sentry/react": "^10.39.0",
    "@stripe/react-stripe-js": "^2.7.1",
    "@stripe/stripe-js": "^4.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-virtual": "^3.13.5",
    "@types/react-window": "^1.8.8",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "formidable": "2.1.5",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-window": "^2.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "wrangler": "^3.28.1"
  }
}
