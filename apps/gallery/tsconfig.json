{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "jest", "@testing-library/jest-dom", "vite/client"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Strict Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": false,

    /* Additional Checks */
    // noUnusedLocals / noUnusedParameters disabled — too many pre-existing violations;
    // re-enable once the codebase is clean.
    "noFallthroughCasesInSwitch": true,
    // noUncheckedIndexedAccess / exactOptionalPropertyTypes disabled — overly pedantic
    // for this codebase at the current stage; can be re-enabled incrementally.

    /* Interop Constraints */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "src/setupTests.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "backend",
    "tests",
    "**/__tests__/**",
    "playwright.config.ts",
    "jest.config.ts",
    "vite.config.ts",
    "src/services/aiSearchService.ts",
    "src/schemas/payment.ts",
    "src/services/stripeEdgeService.ts",
    "src/services/geminiService.ts",
    "src/utils/testUtils.tsx",
    "src/utils/sentry.ts",
    "src/services/performanceMonitor.ts",
    "src/components/error-boundaries/FeatureErrorBoundary.tsx",
    "src/services/advancedCheckout.ts",
    "src/services/persistentCart.ts"
  ]
}
