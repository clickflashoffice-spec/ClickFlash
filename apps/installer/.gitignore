# ==========================================
# ClickFlash Unified .gitignore
# Generated: June 2026
# Purpose: Prevent committing secrets, runtime data, and build artifacts
# ==========================================

# --- Environment Files (CRITICAL: Never commit secrets) ---
.env
.env.local
.env.development
.env.production
.env.test
*.env
!*.env.example
!*.env.template

# --- Generated Private Signing Keys (never commit) ---
payload-private-key.pem
payload_private_key.pem
*-private-key.pem
*_private_key.pem
private_key.pem
*.private.pem

# --- Runtime Data ---
pb_data/
*.db
*.db-shm
*.db-wal
*.log
logs/
*.sqlite
*.sqlite3

# --- Node / Package Manager ---
node_modules/
.pnpm-store/
.npmrc

# --- Build Outputs ---
dist/
build/
.next/
.nuxt/
.output/
.vercel/
.wrangler/
*.tsbuildinfo
coverage/
out/
target/
release/

# --- Electron ---
*.exe
*.dmg
*.msi
*.deb
*.rpm
*.AppImage
*.snap
release/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Testing ---
test-results/
playwright-report/
playwright/.cache/

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.bak
