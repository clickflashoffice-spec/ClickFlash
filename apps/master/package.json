{
  "name": "clickflash-master",
  "version": "4.2.0",
  "description": "ClickFlash - Master Portal Application",
  "author": "ClickFlash Photography",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --watch",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "dev:electron": "concurrently \"npm run dev:backend\" \"npm run dev:watch\" \"wait-on http://localhost:8090/api/health file:dist/master/index.html && electron .\" --names \"backend,frontend,electron\" --prefix-colors \"blue,green,cyan\" --kill-others-on-fail",
    "dev:backend": "tsx watch backend/server.ts",
    "preview:full": "concurrently \"npm run dev:backend\" \"npm run preview\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "clean": "rimraf dist release",
    "build": "vite build",
    "build:backend": "esbuild \"server=backend/server.ts\" \"workers/photoWorker=backend/workers/photoWorker.ts\" \"workers/folderWorker=backend/workers/folderWorker.ts\" \"main/autoUpdater=src/main/autoUpdater.ts\" \"main/backupService=src/main/backupService.ts\" --bundle --minify --platform=node --target=node20 --outdir=dist/backend --external:electron --external:electron-updater --external:better-sqlite3 --external:better-sqlite3-multiple-ciphers --external:better-sqlite3-session-store --external:sharp --external:bcryptjs --external:adm-zip --external:bonjour-service --external:express-session --external:formidable --external:helmet --external:jsonwebtoken --external:pdf-to-printer --external:fs-extra --external:form-data --external:ws --external:express --external:@tensorflow/tfjs-node --external:@napi-rs/canvas --external:archiver --external:nodemailer --drop:debugger && tsx scripts/copy-assets.ts",
    "package": "npm run clean && npm run build && npm run build:backend && electron-builder build --win --dir",
    "package:installer": "npm run clean && npm run build && npm run build:backend && electron-builder build --win",
    "preview": "vite preview",
    "start": "node -r dotenv/config dist/backend/server.js",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck:ci": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "provision": "tsx backend/scripts/provision-hardware.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@napi-rs/canvas": "^0.1.86",
    "@sentry/react": "^8.0.0",
    "@tanstack/react-query": "^5.90.10",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/react-window": "^1.8.8",
    "@types/stripe": "^8.0.416",
    "@vladmandic/face-api": "^1.7.15",
    "adm-zip": "^0.5.16",
    "apexcharts": "^3.45.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3-multiple-ciphers": "^12.8.0",
    "better-sqlite3-session-store": "^0.1.0",
    "bonjour-service": "^1.3.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "flatpickr": "^4.6.13",
    "form-data": "^4.0.5",
    "formidable": "^2.1.5",
    "framer-motion": "^12.26.2",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jsvectormap": "^1.5.3",
    "lucide-react": "^0.562.0",
    "nodemailer": "^7.0.12",
    "pdf-to-printer": "^5.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-apexcharts": "^1.4.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-virtuoso": "^4.18.1",
    "react-window": "^2.2.5",
    "resend": "^6.9.3",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.2",
    "stripe": "^20.2.0",
    "systeminformation": "^5.30.5",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "overrides": {
    "fast-xml-parser": "^4.4.1",
    "tar": "^7.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/form-data": "^2.2.1",
    "@types/formidable": "^3.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/helmet": "^0.0.48",
    "@types/ip": "^1.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001761",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "electron": "^39.8.7",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.27.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
