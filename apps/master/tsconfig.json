{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "types": ["react", "react-dom", "vite/client", "node", "jest"],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "./node_modules"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@services/*": ["./src/services/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"],
      "@clickflash/ui/*": ["../../packages/ui/src/*"],
      "@clickflash/ui": ["../../packages/ui/src/index.ts"],
      "@clickflash/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src", "backend", "scripts"],
  "exclude": ["node_modules", "dist", "release", "src/wasm"]
}
