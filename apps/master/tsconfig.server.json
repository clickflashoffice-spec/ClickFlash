{
    "compilerOptions": {
    "types": ["node"],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "outDir": "./dist/backend",
        "rootDir": "../../",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "paths": {
            "@clickflash/types": ["../../packages/types/src/index.ts"],
            "@clickflash/ai-core": ["../../packages/ai-core/src/index.ts"],
            "@clickflash/ai-core/*": ["../../packages/ai-core/src/*"]
        }
    },
    "include": [
        "backend/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "**/*.test.ts",
        "backend/**/*.js",
        "backend/**/*.cjs",
        "backend/setup/stressTask.ts"
    ]
}