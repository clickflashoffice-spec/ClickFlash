{
  "expo": {
    "name": "ClickFlash Pass",
    "slug": "clickflash-pass",
    "scheme": "clickflash-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clickflash.pass",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "ClickFlash needs Bluetooth to automatically link your high-speed ride photos and photographer shots.",
        "NSBluetoothPeripheralUsageDescription": "ClickFlash uses Bluetooth to seamlessly link your gallery while you explore."
      }
    },
    "android": {
      "package": "com.clickflash.pass",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
