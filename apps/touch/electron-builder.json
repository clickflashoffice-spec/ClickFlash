{
  "appId": "com.clickflash.touch",
  "productName": "ClickFlash - Touch Kiosk",
  "copyright": "Copyright © 2025 ClickFlash Photography",
  "electronVersion": "39.8.7",
  "compression": "maximum",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "afterPack": "./scripts/ensure-native-deps.js",
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3-multiple-ciphers/**/*",
    "node_modules/sharp/**/*",
    "node_modules/bcrypt/**/*",
    "node_modules/bonjour-service/**/*",
    "node_modules/multicast-dns/**/*",
    "node_modules/dns-packet/**/*",
    "node_modules/thunky/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*",
    "node_modules/napi-build-utils/**/*",
    "node_modules/node-addon-api/**/*",
    "node_modules/prebuild-install/**/*",
    "node_modules/simple-get/**/*",
    "node_modules/detect-libc/**/*"
  ],
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "autoUpdater.js",
    "package.json",
    "!pb_data/**/*",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/backend",
      "to": "backend/touch",
      "filter": ["**/*"]
    },
    {
      "from": "installer_scripts",
      "to": "installer_scripts"
    },
    {
      "from": "pb_data",
      "to": "pb_data",
      "filter": ["!**/*.db", "!**/*.log"]
    },
    {
      "from": "scripts",
      "to": "scripts"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "forceCodeSigning": false,
    "signAndEditExecutable": false,
    "sign": "../../scripts/ev-sign.js"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": false,
    "runAfterFinish": false,
    "shortcutName": "ClickFlash Touch",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "uninstallDisplayName": "ClickFlash Touch",
    "warningsAsErrors": false
  },
  "publish": {
    "provider": "github",
    "owner": "clickflash",
    "repo": "clickflash-touch",
    "releaseType": "release",
    "vPrefixedTagName": true
  }
}
