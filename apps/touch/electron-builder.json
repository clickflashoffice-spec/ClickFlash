{
  "appId": "com.clickflash.touch",
  "productName": "ClickFlash - Touch Kiosk",
  "copyright": "Copyright © 2025 ClickFlash Photography",
  "npmRebuild": false,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "package.json",
    "!pb_data/**/*",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/backend",
      "to": "backend/touch",
      "filter": ["**/*"]
    },
    {
      "from": "pb_data",
      "to": "pb_data",
      "filter": ["!**/*.db", "!**/*.log"]
    },
    {
      "from": "scripts",
      "to": "scripts"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "forceCodeSigning": false,
    "signAndEditExecutable": false,
    "sign": null
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "deleteAppDataOnUninstall": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "runAfterFinish": false,
    "shortcutName": "ClickFlash Touch"
  }
}
