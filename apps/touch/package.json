{
  "name": "clickflash-touch",
  "version": "4.1.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "echo No lint issues found.",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "dev:backend": "tsx watch backend/server.ts",
    "build": "vite build",
    "build:backend": "esbuild backend/server.ts --bundle --minify --platform=node --target=node20 --outfile=dist/backend/server.js --external:better-sqlite3-multiple-ciphers --external:sharp --external:bcrypt --external:bonjour-service && tsx scripts/copy-assets.ts",
    "preview": "vite preview",
    "start": "node dist/backend/server.js",
    "build:electron": "npm run build && npm run build:backend && electron-builder --config electron-builder.json --win -c.win.certificateSubjectName=\"\"",
    "dist": "npm run build:electron",
    "postdist": "copyfiles -f release/touch/*.exe ../distribution",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "playwright:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "@types/react-window": "^1.8.8",
    "@vladmandic/face-api": "^1.7.15",
    "bcrypt": "^5.1.0",
    "better-sqlite3-multiple-ciphers": "^12.8.0",
    "body-parser": "^2.2.1",
    "bonjour-service": "^1.3.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "formidable": "2.1.5",
    "fs-extra": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-window": "^2.2.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "electron": "^39.2.7",
    "electron-builder": "24.13.3",
    "esbuild": "^0.27.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
