{
  "name": "clickflash-touch",
  "version": "2.0.0",
  "private": true,
  "description": "ClickFlash - Touch Kiosk Application",
  "author": "ClickFlash Photography",
  "packageManager": "pnpm@10.28.2",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "dev:frontend": "vite",
    "dev:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "dev:full": "npm run dev",
    "dev:electron": "concurrently \"npm run dev:backend\" \"npm run dev:watch\" \"wait-on http://localhost:8091/api/health && electron .\" --names \"backend,frontend,electron\" --prefix-colors \"blue,green,cyan\" --kill-others-on-fail",
    "dev:backend": "npx tsx watch backend/server.ts",
    "build": "vite build",
    "build:backend": "esbuild backend/server.ts --bundle --minify --platform=node --target=node20 --outfile=dist/backend/server.js --external:better-sqlite3-multiple-ciphers --external:sharp --external:bcrypt --external:bonjour-service && tsx scripts/copy-assets.ts",
    "build:electron-ts": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "start": "node dist/backend/server.js",
    "build:electron": "npm run build && npm run build:backend && npm run build:electron-ts && electron-builder --config electron-builder.json --win",
    "dist": "npm run build:electron",
    "postdist": "copyfiles -f release/touch/*.exe ../distribution",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "playwright:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@clickflash/logger": "workspace:*",
    "@clickflash/telemetry-web": "workspace:*",
    "@clickflash/types": "workspace:*",
    "@serialport/parser-readline": "^13.0.0",
    "@tanstack/react-query": "^5.90.10",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react-window": "^1.8.8",
    "@vladmandic/face-api": "^1.7.15",
    "bcrypt": "^5.1.0",
    "better-sqlite3-multiple-ciphers": "^12.8.0",
    "bindings": "^1.5.0",
    "body-parser": "^2.2.1",
    "bonjour-service": "^1.3.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "file-uri-to-path": "2.0.0",
    "formidable": "2.1.5",
    "framer-motion": "^12.34.0",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-window": "^1.8.11",
    "serialport": "^13.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "uuid": "^10.0.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "electron": "^39.8.7",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.9"
  }
}
