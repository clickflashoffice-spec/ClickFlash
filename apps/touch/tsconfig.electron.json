{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "outDir": "./dist/electron",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["main.ts", "preload.ts", "autoUpdater.d.ts"],
    "exclude": ["node_modules", "dist", "src", "backend", "electron"]
}
