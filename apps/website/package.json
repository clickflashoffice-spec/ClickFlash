    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dompurify": "^3.4.11",
    "framer-motion": "^12.26.2",
    "gsap": "^3.12.5",
    "lucide-react": "^0.577.0",
    "next": "^15.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tweetnacl": "^1.0.3",
    "@clickflash/logger": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/next-on-pages": "^1.13.0",
