@startuml ClickFlash-Master-Routes

title Master Portal API Routes (21 Routes)

package "Authentication" {
  [POST /api/auth/login] as auth_login
  [POST /api/auth/logout] as auth_logout
  [GET /api/auth/session] as auth_session
  [POST /api/auth/signup] as auth_signup
}

package "Collections CRUD" {
  [GET /api/collections] as coll_list
  [GET /api/collections/:type] as coll_get
  [GET /api/collections/:type/:id] as coll_get_one
  [POST /api/collections/:type/:id] as coll_create
  [PUT /api/collections/:type/:id] as coll_update
  [DELETE /api/collections/:type/:id] as coll_delete
}

package "Cloud Sync" {
  [GET /api/cloud/status] as cloud_status
  [POST /api/cloud/sync] as cloud_sync
}

package "Orders & Fulfillment" {
  [GET /api/orders] as orders_list
  [GET /api/orders/:id] as orders_get
  [POST /api/orders/:id] as orders_create
  [PUT /api/orders/:id] as orders_update
  [POST /api/orders/:id/export] as orders_export
}

package "AI & Recognition" {
  [POST /api/faces/search] as faces_search
  [POST /api/faces/reindex] as faces_reindex
  [POST /api/culling/analyze] as culling_analyze
}

package "Pairing & Sync" {
  [POST /api/pairing/initiate] as pairing_init
  [POST /api/pairing/confirm] as pairing_confirm
  [POST /api/sync/push] as sync_push
  [GET /api/sync/pull] as sync_pull
}

package "System" {
  [POST /api/files/upload] as files_upload
  [GET /api/files/:id] as files_get
  [GET /api/system/health] as sys_health
  [GET /api/system/info] as sys_info
  [GET /api/realtime/events] as realtime_events
}

auth_login --> auth_session
orders_create --> orders_export
pairing_init --> pairing_confirm

@enduml
