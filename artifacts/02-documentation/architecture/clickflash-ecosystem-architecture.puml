@startuml ClickFlash-Ecosystem-Architecture

!include <office/Server>
!include <office/Database>
!include <office/Users>
!include <office/Globe>

title ClickFlash Photography Ecosystem - Architecture Overview

package "Local Network (Offline-First)" {
  [🎛️ Master Portal\napps/master/\nPort 8090\nElectron + React 19] as master
  [📱 Touch Kiosk\napps/touch/\nPort 8091\nElectron + React 19] as touch
  [💰 MoneyTrash\napps/moneytrash/\nPort 3000\nNext.js 16 + Tauri] as moneytrash
  
  database "SQLite" as master_db
  database "SQLite" as touch_db
  
  master --> master_db : local data
  touch --> touch_db : local data
  master <--> touch : HMAC-signed sync
}

package "Cloud Services (Online)" {
  [📊 Management Hub\napps/management/\nPort 5173\nReact 19 + Vite] as mgmt
  [🛍️ Customer Gallery\napps/gallery/\nPort 5174\nReact 19 + Vite + Stripe] as gallery
  [🌐 Main Website\napps/website/\nPort 3001\nNext.js 15] as website
  
  database "Supabase" as supabase
  database "D1 Database" as d1
  database "R2 Storage" as r2
  
  gallery --> d1 : user data
  gallery --> r2 : photo storage
  gallery --> supabase : sync
}

package "COP Clone" {
  [CPP Master Clone\napps/master-cpp/\nC++/Qt\nQtractor] as cpp
}

master --> mgmt : cloud sync
touch --> gallery : order export
moneytrash --> r2 : S3 upload

note right of master
  21 API routes
  Express + SQLite
  better-sqlite3
end note

note right of touch
  8 API routes
  HMAC-SHA256 auth
  Offline queue
end note

note bottom of gallery
  Cloudflare Workers
  Stripe payments
  JWT authentication
end note

@enduml
