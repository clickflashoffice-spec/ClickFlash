{
  "title": "ClickFlash Executive Dashboard",
  "version": "1.0",
  "panels": [
    {
      "id": 1,
      "title": "Overall Health Score",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "clickflash_health_score"}],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            {"value": 0, "color": "red", "label": "Critical"},
            {"value": 50, "color": "orange", "label": "Poor"},
            {"value": 75, "color": "yellow", "label": "Fair"},
            {"value": 90, "color": "green", "label": "Good"}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Open Findings by Severity",
      "type": "bargauge",
      "gridPos": {"x": 4, "y": 0, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_findings_severity{severity=\"critical\"}", "legendFormat": "Critical"},
        {"expr": "clickflash_findings_severity{severity=\"high\"}", "legendFormat": "High"},
        {"expr": "clickflash_findings_severity{severity=\"medium\"}", "legendFormat": "Medium"},
        {"expr": "clickflash_findings_severity{severity=\"low\"}", "legendFormat": "Low"}
      ]
    },
    {
      "id": 3,
      "title": "Remediation Progress",
      "type": "progress",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "clickflash_findings_closed_total"},
        {"expr": "clickflash_findings_total"}
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "title": "Compliance Status",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
      "targets": [
        {"expr": "clickflash_gdpr_score", "legendFormat": "GDPR"},
        {"expr": "clickflash_ccpa_score", "legendFormat": "CCPA"}
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 70, "color": "orange"},
              {"value": 90, "color": "yellow"},
              {"value": 100, "color": "green"}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Days Since Last Incident",
      "type": "stat",
      "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4},
      "targets": [{"expr": "clickflash_days_since_incident"}],
      "options": {
        "colorMode": "value",
        "thresholds": {
          "steps": [
            {"value": 0, "color": "red"},
            {"value": 7, "color": "orange"},
            {"value": 30, "color": "green"}
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Critical Vulnerabilities",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 4},
      "targets": [
        {"expr": "clickflash_critical_vulnerabilities", "legendFormat": "Critical"}
      ]
    },
    {
      "id": 7,
      "title": "Build Success Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_build_success_rate{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_build_success_rate{app=\"touch\"}", "legendFormat": "Touch"},
        {"expr": "clickflash_build_success_rate{app=\"gallery\"}", "legendFormat": "Gallery"}
      ]
    },
    {
      "id": 8,
      "title": "Error Rate by App",
      "type": "bargauge",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_error_rate{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_error_rate{app=\"touch\"}", "legendFormat": "Touch"},
        {"expr": "clickflash_error_rate{app=\"gallery\"}", "legendFormat": "Gallery"},
        {"expr": "clickflash_error_rate{app=\"moneytrash\"}", "legendFormat": "MoneyTrash"}
      ]
    },
    {
      "id": 9,
      "title": "Upcoming Re-Audits",
      "type": "table",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 4},
      "targets": [{"expr": "clickflash_scheduled_audits"}],
      "transform": "table"
    }
  ],
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  }
}