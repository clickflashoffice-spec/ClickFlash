{
  "title": "ClickFlash Technical Dashboard",
  "version": "1.0",
  "panels": [
    {
      "id": 1,
      "title": "Build Success Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4},
      "targets": [
        {"expr": "clickflash_build_success_rate{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_build_success_rate{app=\"touch\"}", "legendFormat": "Touch"},
        {"expr": "clickflash_build_success_rate{app=\"moneytrash\"}", "legendFormat": "MoneyTrash"},
        {"expr": "clickflash_build_success_rate{app=\"management\"}", "legendFormat": "Management"},
        {"expr": "clickflash_build_success_rate{app=\"gallery\"}", "legendFormat": "Gallery"},
        {"expr": "clickflash_build_success_rate{app=\"website\"}", "legendFormat": "Website"}
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 2,
      "title": "Test Coverage Trend",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4},
      "targets": [
        {"expr": "clickflash_test_coverage{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_test_coverage{app=\"gallery\"}", "legendFormat": "Gallery"},
        {"expr": "clickflash_test_coverage{app=\"management\"}", "legendFormat": "Management"}
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "id": 3,
      "title": "Vulnerability Count",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_vulnerabilities{severity=\"critical\"}", "legendFormat": "Critical"},
        {"expr": "clickflash_vulnerabilities{severity=\"high\"}", "legendFormat": "High"},
        {"expr": "clickflash_vulnerabilities{severity=\"medium\"}", "legendFormat": "Medium"}
      ],
      "stack": true
    },
    {
      "id": 4,
      "title": "Dependency Age",
      "type": "bargauge",
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_dependency_age_days{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_dependency_age_days{app=\"touch\"}", "legendFormat": "Touch"},
        {"expr": "clickflash_dependency_age_days{app=\"gallery\"}", "legendFormat": "Gallery"}
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 180,
          "unit": "days",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 90, "color": "yellow"},
              {"value": 180, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "API Latency p95",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_api_latency_p95{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_api_latency_p95{app=\"gallery\"}", "legendFormat": "Gallery"},
        {"expr": "clickflash_api_latency_p95{app=\"management\"}", "legendFormat": "Management"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 200, "color": "yellow"},
              {"value": 500, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "API Latency p99",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_api_latency_p99{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_api_latency_p99{app=\"gallery\"}", "legendFormat": "Gallery"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 500, "color": "yellow"},
              {"value": 1000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Error Rate by App",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_error_rate{app=\"master\"}", "legendFormat": "Master"},
        {"expr": "clickflash_error_rate{app=\"touch\"}", "legendFormat": "Touch"},
        {"expr": "clickflash_error_rate{app=\"gallery\"}", "legendFormat": "Gallery"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Outdated Packages",
      "type": "table",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_outdated_packages", "format": "table"},
        {"expr": "clickflash_deprecated_packages", "format": "table"}
      ],
      "transform": "table"
    },
    {
      "id": 9,
      "title": "MTTR (Hours)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 12, "w": 4, "h": 4},
      "targets": [{"expr": "clickflash_mttr_hours"}],
      "fieldConfig": {
        "defaults": {
          "unit": "hours",
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 4, "color": "yellow"},
              {"value": 8, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Secrets Detected",
      "type": "timeseries",
      "gridPos": {"x": 4, "y": 12, "w": 8, "h": 4},
      "targets": [
        {"expr": "clickflash_secrets_detected_total"}
      ],
      "options": {
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Layer Coverage",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 4},
      "targets": [
        {"expr": "clickflash_layer_coverage{layer=\"frontend\"}", "legendFormat": "Frontend"},
        {"expr": "clickflash_layer_coverage{layer=\"backend\"}", "legendFormat": "Backend"},
        {"expr": "clickflash_layer_coverage{layer=\"security\"}", "legendFormat": "Security"},
        {"expr": "clickflash_layer_coverage{layer=\"operations\"}", "legendFormat": "Operations"}
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    }
  ],
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  }
}