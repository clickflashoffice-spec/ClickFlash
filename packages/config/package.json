{
  "name": "@clickflash/config",
  "version": "2.0.0",
  "description": "Shared configuration files for the ClickFlash monorepo",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig": "./tsconfig.json",
    "./tailwind": "./tailwind.config.js",
    "./security-headers": "./dist/security-headers.js",
    "./error-logger": "./dist/error-logger.js"
  },
  "files": [
    "*.js",
    "*.json",
    "dist"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "clean": "rm -rf node_modules/.cache dist"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@clickflash/logger": "workspace:*"
  }
}
