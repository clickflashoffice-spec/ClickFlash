{
  "name": "@clickflash/test-utils",
  "version": "2.0.0",
  "description": "Shared test utilities and helpers for the ClickFlash monorepo",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "msw": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "eslint": "^9.0.0",
    "react": "^19.2.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.7"
  }
}
