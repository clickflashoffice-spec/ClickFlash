{
  "name": "clickflash-test-suite",
  "version": "1.0.0",
  "description": "ClickFlash Ecosystem - Automated Test Suite",
  "scripts": {
    "test": "npm run test:smoke && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:smoke": "node scripts/smoke-test.js",
    "test:unit": "jest --config=jest.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:e2e:master": "playwright test --project=master-chromium",
    "test:e2e:touch": "playwright test --project=touch-chromium",
    "test:e2e:website": "playwright test --project=website-chromium",
    "test:e2e:website:mobile": "playwright test --project=website-mobile",
    "test:e2e:all": "playwright test --project=master-chromium --project=master-firefox --project=touch-chromium --project=website-chromium --project=website-mobile",
    "test:security": "npm run test:security:auth && npm run test:security:xss && npm run test:security:sqli && npm run test:security:headers",
    "test:security:auth": "jest --testPathPattern=security/auth.test.ts",
    "test:security:xss": "jest --testPathPattern=security/xss.test.ts",
    "test:security:sqli": "jest --testPathPattern=security/sqli.test.ts",
    "test:security:headers": "jest --testPathPattern=security/headers.test.ts",
    "test:performance": "artillery run performance/load-test.yml",
    "test:performance:api": "artillery run performance/api-load-test.yml",
    "test:performance:website": "artillery run performance/website-load-test.yml",
    "test:report": "playwright show-report test-results/html-report",
    "test:ci": "npm run test:smoke && npm run test:unit && npm run test:integration",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "artillery": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.0"
  }
}
